{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: dev (full stack)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "command": "pnpm dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s/dashboard",
        "action": "openExternally"
      }
    }
  ]
}
